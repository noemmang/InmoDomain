# Cadenas de conexión de Neon (formato ADO.NET de Npgsql, host con -pooler).
IDENTITY_CONNECTION=
PROPERTY_CONNECTION=
MARKETDATA_CONNECTION=
ANALYTICS_CONNECTION=
ALERTS_CONNECTION=
NOTIFICATIONS_CONNECTION=

# Emulador de Service Bus accedido por el alias de red del contenedor.
SERVICEBUS_CONNECTION=Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# Par de claves RS256 (base64 de la clave DER). La privada solo la usa Identity.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Clave de la API de Resend.
RESEND_API_KEY=

# Claves internas entre servicios: Analytics -> Market Data y Alerts -> Analytics.
MARKETDATA_API_KEY=
ANALYTICS_API_KEY=

# Origen permitido por CORS en el Gateway.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Nombre y etiqueta de las imágenes.
IMAGE_PREFIX=ghcr.io/noemmang/inmodomain
IMAGE_TAG=local