{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "InmoDomain.Identity",
    "Audience": "InmoDomain"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-register": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/register",
          "Methods": [ "POST" ]
        }
      },
      "identity-login": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/login",
          "Methods": [ "POST" ]
        }
      },
      "identity-refresh": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/refresh",
          "Methods": [ "POST" ]
        }
      },
      "identity-logout": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/auth/logout",
          "Methods": [ "POST" ]
        }
      },
      "identity-forgot-password": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/forgot-password",
          "Methods": [ "POST" ]
        }
      },
      "identity-reset-password": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/reset-password",
          "Methods": [ "POST" ]
        }
      },
      "identity-me": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/auth/me",
          "Methods": [ "GET", "PUT" ]
        }
      },
      "identity-me-password": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/auth/me/password",
          "Methods": [ "PUT" ]
        }
      },
      "property-provinces": {
        "ClusterId": "property",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/provinces",
          "Methods": [ "GET" ]
        }
      },
      "property-province-detail": {
        "ClusterId": "property",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/provinces/{provinceCode}",
          "Methods": [ "GET" ]
        }
      },
      "property-favorites": {
        "ClusterId": "property",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/favorites",
          "Methods": [ "GET", "POST" ]
        }
      },
      "property-favorite-detail": {
        "ClusterId": "property",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/favorites/{id}",
          "Methods": [ "DELETE" ]
        }
      },
      "analytics-province": {
        "ClusterId": "analytics",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/provinces/{provinceCode}/analytics",
          "Methods": [ "GET" ]
        }
      },
      "analytics-compare": {
        "ClusterId": "analytics",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/analytics/compare",
          "Methods": [ "GET" ]
        }
      },
      "alerts-list": {
        "ClusterId": "alerts",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/alerts",
          "Methods": [ "GET", "POST" ]
        }
      },
      "alerts-detail": {
        "ClusterId": "alerts",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/alerts/{id}",
          "Methods": [ "PUT", "DELETE" ]
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "identity": { "Address": "http://localhost:5071/" } }
      },
      "property": {
        "Destinations": { "property": { "Address": "http://localhost:5081/" } }
      },
      "analytics": {
        "Destinations": { "analytics": { "Address": "http://localhost:5041/" } }
      },
      "alerts": {
        "Destinations": { "alerts": { "Address": "http://localhost:5091/" } }
      }
    }
  }
}