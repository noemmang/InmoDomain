# Región de Azure. Conviene que coincida con la región del proyecto Neon.
AZURE_LOCATION=westeurope

# Correo que recibe los avisos del presupuesto mensual.
BUDGET_EMAIL=

# Imágenes publicadas por el CI en GHCR.
IMAGE_PREFIX=ghcr.io/noemmang/inmodomain
IMAGE_TAG=latest

# Cadenas de conexión de Neon (formato ADO.NET de Npgsql, host con -pooler).
IDENTITY_CONNECTION=
PROPERTY_CONNECTION=
MARKETDATA_CONNECTION=
ANALYTICS_CONNECTION=
ALERTS_CONNECTION=
NOTIFICATIONS_CONNECTION=

# Par de claves RS256 (base64 de la clave DER). La privada solo la usa Identity.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Claves internas entre servicios: Analytics -> Market Data y Alerts -> Analytics.
MARKETDATA_API_KEY=
ANALYTICS_API_KEY=

# Resend: clave de la API y remitente (el dominio debe estar verificado en Resend).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=InmoDomain <onboarding@resend.dev>

# Origen del frontend (CORS del Gateway) y URL de restablecimiento de contraseña.
CORS_ALLOWED_ORIGIN=
FRONTEND_RESET_PASSWORD_URL=

# Job de importación: cron en UTC y número de periodos que pide al INE.
IMPORT_CRON=0 5 * * *
IMPORT_LAST_PERIODS=3